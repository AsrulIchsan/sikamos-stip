# =========================================================================
# SIKAMOS - STIP International Kadet Mobility System
# Panduan Environment Variables untuk Lokal & Vercel Production
# =========================================================================

# 1. DATABASE_URL
# Opsi A (Lokal - SQLite Standalone zero-config):
DATABASE_URL="file:./dev.db"

# Opsi B (Vercel Production - Cloud PostgreSQL: Neon.tech, Supabase, atau Vercel Postgres):
# DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. NextAuth Configuration
# Untuk Lokal: "http://localhost:3000"
# Untuk Vercel: "https://nama-aplikasi-anda.vercel.app" (atau biarkan kosong di Vercel jika NextAuth v4 mendeteksi VERCEL_URL)
NEXTAUTH_URL="http://localhost:3000"

# Kunci rahasia token JWT (bisa diisi string acak atau generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET="sikamos_stip_super_secret_jwt_key_2026"
